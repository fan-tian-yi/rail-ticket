server:
  port: 8080

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/rail_ticket?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: root
    password: <your-mysql-password>
    driver-class-name: com.mysql.cj.jdbc.Driver
  flyway:
    enabled: true
    locations: classpath:db/migration
    baseline-on-migrate: true
  data:
    redis:
      host: localhost
      port: 6379
      password: <your-redis-password>

mybatis-plus:
  configuration:
    map-underscore-to-camel-case: true
  global-config:
    db-config:
      id-type: assign_id
      logic-delete-field: deleted
      logic-delete-value: 1
      logic-not-delete-value: 0

logging:
  file:
    # 日志文件路径。建议放项目外，所有项目共用一个日志根目录、按项目名分子目录，方便集中排查。
    # 默认写到项目下的 logs/；也可以由启动环境变量覆盖：LOGGING_FILE_NAME=/var/log/rail-ticket/app.log
    name: ${LOG_DIR:logs}/rail-ticket.log
  logback:
    rollingpolicy:
      max-file-size: 10MB      # 单文件超 10MB 切分
      max-history: 7           # 历史文件保留 7 天
      total-size-cap: 500MB    # 历史文件总大小上限，防止日志把磁盘写满
      # 历史文件命名：默认是 .gz 压缩包，改成明文 .log 才能直接用文本工具 / 日志查看器打开
      file-name-pattern: ${LOG_DIR:logs}/rail-ticket.%d{yyyy-MM-dd}.%i.log
  level:
    com.tianyi.railticket: INFO
    # 打印 Mapper 执行的 SQL，排查问题时用；不需要时调成 INFO
    com.tianyi.railticket.mapper: DEBUG

sa-token:
  # 请求头名：前端带 Authorization: Bearer <token>
  token-name: Authorization
  token-prefix: Bearer
  # 前后端分离必须关掉从 Cookie/请求体读 token（默认均为 true）
  is-read-cookie: false
  is-read-body: false
  # 绝对有效期 7 天；空闲有效期 30 分钟（两者取先到者，哪个先到按哪个失效）
  timeout: 604800
  active-timeout: 1800
  # 允许同账号多端登录，各端 token 独立（踢人才能精确到设备）
  is-concurrent: true
  is-share: false
  # 关闭 Sa-Token 操作日志（默认 logLevel=trace，每个请求都打，压测时是次要瓶颈）
  is-log: false
